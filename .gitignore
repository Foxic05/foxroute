__pycache__/
*.py[cod]
.venv/
*.egg-info/

# The user's data directory: cookies, tokens, quota stats. FOXROUTE_HOME
# points here too. NEVER goes into the repository.
/data/
accounts.json
*_cookies.json
*_tokens.json
meta_ws_auth.json
alice_sent_frame.json
settings.json
cache/

# The package's factory data — the opposite: it MUST be in the repository.
# Without measurements.json the layer doesn't know provider windows; without
# the wasm module DeepSeek can't compute the request signature.
!foxroute/data/
!foxroute/data/*

# ── Not for the public repository (kept locally) ─────────────────────
# Reference sources, used only for protocol cross-checks — not our code.
reference/
# Internal vulnerability report — a map of weak spots, needless in public.
audit.json
# Working scratch file with model lists — not for the repository.
wr.txt
